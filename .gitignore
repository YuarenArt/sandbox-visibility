# Сторонние бинари: bpftrace, runsc, firecracker, распакованный AppImage.
# Восемьсот мегабайт, качаются скриптами, в истории им делать нечего.
bin/

# Raw traces are not published: they are taken machine-wide and carry the names
# of unrelated processes. Manifests, truth files and the summary are published
# under results/published/ so the table can be audited.
results/*
!results/published/

# Local paths, one per machine.
config.local

# Сборочный мусор и временное.
*.o
*.bak
