#!/usr/bin/env bpftrace
/*
 * $1 = this tracer's own pid; its marker output must not be measured.
 * $2 = base port for connect().
 *
 * Event format is a contract: every line carries both the exact syscall name
 * and an op= label. analyze.sh compares by op=, run/selftest.sh matches on the
 * syscall name. A probe added without op=, or with a different field order,
 * empties a column with no error anywhere.
 *
 * Selection is by argument content, never by comm: a comm pattern misses
 * vring_worker and fc_vcpu, and the kernel truncates qemu-system-x86_64 to
 * fifteen characters. The one place that does match on comm, the image-marker
 * count in run/vms.sh, relies on that truncation.
 */

BEGIN
{
	printf("TRACE-READY selfpid=%d nsecs=%lld\n", $1, nsecs);
}

/* Legacy open() is required: firecracker opens the image and the kernel with it. */
tracepoint:syscalls:sys_enter_open
/pid != $1 && strcontains(str(args.filename), "SVP-")/
{
	printf("EVT %lld %s %d open op=open %s\n", nsecs, comm, pid,
	       str(args.filename));
	@n_open = count();
}

tracepoint:syscalls:sys_enter_openat
/pid != $1 && strcontains(str(args.filename), "SVP-")/
{
	printf("EVT %lld %s %d openat op=open %s\n", nsecs, comm, pid,
	       str(args.filename));
	@n_open = count();
}

tracepoint:syscalls:sys_enter_openat2
/pid != $1 && strcontains(str(args.filename), "SVP-")/
{
	printf("EVT %lld %s %d openat2 op=open %s\n", nsecs, comm, pid,
	       str(args.filename));
	@n_open = count();
}

tracepoint:syscalls:sys_enter_unlink
/pid != $1 && strcontains(str(args.pathname), "SVP-")/
{
	printf("EVT %lld %s %d unlink op=unlink %s\n", nsecs, comm, pid,
	       str(args.pathname));
	@n_unlink = count();
}

tracepoint:syscalls:sys_enter_unlinkat
/pid != $1 && strcontains(str(args.pathname), "SVP-")/
{
	printf("EVT %lld %s %d unlinkat op=unlink %s\n", nsecs, comm, pid,
	       str(args.pathname));
	@n_unlink = count();
}

tracepoint:syscalls:sys_enter_execve
/pid != $1 && strcontains(str(args.filename), "SVP-")/
{
	printf("EVT %lld %s %d execve op=exec %s\n", nsecs, comm, pid,
	       str(args.filename));
	@n_exec = count();
}

tracepoint:syscalls:sys_enter_execveat
/pid != $1 && strcontains(str(args.filename), "SVP-")/
{
	printf("EVT %lld %s %d execveat op=exec %s\n", nsecs, comm, pid,
	       str(args.filename));
	@n_exec = count();
}

/*
 * Prefix, not substring: the guest's own truth file repeats every token, and a
 * substring match would count that file as measured writes. Keep strncmp();
 * str(args.buf, 4) == "SVP-" reads the NUL byte and never matches.
 */
tracepoint:syscalls:sys_enter_write
/pid != $1 && args.count > 4 &&
 strncmp(str(args.buf, 8), "SVP-", 4) == 0/
{
	printf("EVT %lld %s %d write op=write %s\n", nsecs, comm, pid,
	       str(args.buf, 96));
	@n_write = count();
}

/* Content also leaves through pwritev: that is how virtiofsd writes. */
tracepoint:syscalls:sys_enter_pwrite64
/pid != $1 && args.count > 4 &&
 strncmp(str(args.buf, 8), "SVP-", 4) == 0/
{
	printf("EVT %lld %s %d pwrite64 op=write %s\n", nsecs, comm, pid,
	       str(args.buf, 96));
	@n_write = count();
}

tracepoint:syscalls:sys_enter_writev
/pid != $1 && args.vlen > 0/
{
	$iov = (struct iovec *)uptr(args.vec);
	if (strncmp(str($iov->iov_base, 8), "SVP-", 4) == 0) {
		printf("EVT %lld %s %d writev op=write %s\n", nsecs, comm, pid,
		       str($iov->iov_base, 96));
		@n_write = count();
	}
}

tracepoint:syscalls:sys_enter_pwritev
/pid != $1 && args.vlen > 0/
{
	$iov = (struct iovec *)uptr(args.vec);
	if (strncmp(str($iov->iov_base, 8), "SVP-", 4) == 0) {
		printf("EVT %lld %s %d pwritev op=write %s\n", nsecs, comm, pid,
		       str($iov->iov_base, 96));
		@n_write = count();
	}
}

tracepoint:syscalls:sys_enter_pwritev2
/pid != $1 && args.vlen > 0/
{
	$iov = (struct iovec *)uptr(args.vec);
	if (strncmp(str($iov->iov_base, 8), "SVP-", 4) == 0) {
		printf("EVT %lld %s %d pwritev2 op=write %s\n", nsecs, comm, pid,
		       str($iov->iov_base, 96));
		@n_write = count();
	}
}

/*
 * sockaddr_in bytes 2..3 are the big-endian port, read raw so the probe does
 * not need struct sockaddr_in in BTF. connect() carries no textual token, so the
 * operation is identified by destination port.
 */
tracepoint:syscalls:sys_enter_connect
/pid != $1 && args.uservaddr != 0/
{
	$b = (uint8 *)uptr(args.uservaddr);
	$port = (uint64)(*($b + 2)) * 256 + (uint64)(*($b + 3));
	if ($port >= $2 && $port < $2 + 10) {
		printf("EVT %lld %s %d connect op=connect port=%d\n", nsecs,
		       comm, pid, $port);
		@n_connect = count();
	}
}

tracepoint:sched:sched_process_exec
{
	@exec_by_comm[comm] = count();
	if (strcontains(str(args.filename), "SVP-")) {
		printf("EVT %lld %s %d sched_exec op=exec %s\n", nsecs, comm,
		       pid, str(args.filename));
		@n_sched_exec = count();
	}
}

tracepoint:sched:sched_process_fork
{
	@fork_by_comm[str(args.parent_comm)] = count();
}

/*
 * Unfiltered counts for the whole write family. They separate "the content did
 * not cross the boundary" from "the probe sits on a different syscall": a zero
 * write column next to a busy vring_worker row here means the latter.
 */
tracepoint:syscalls:sys_enter_write    { @wr_family[comm, "write"] = count(); }
tracepoint:syscalls:sys_enter_pwrite64 { @wr_family[comm, "pwrite64"] = count(); }
tracepoint:syscalls:sys_enter_writev   { @wr_family[comm, "writev"] = count(); }
tracepoint:syscalls:sys_enter_pwritev  { @wr_family[comm, "pwritev"] = count(); }
tracepoint:syscalls:sys_enter_pwritev2 { @wr_family[comm, "pwritev2"] = count(); }

/*
 * Unfiltered liveness maps. Zero markers next to tens of thousands of events
 * from the VMM means the boundary held; zero in both means the harness was
 * broken. Printed whole: truncating to a top-N drops the very process the
 * evidence is about on a loaded machine.
 */
tracepoint:raw_syscalls:sys_enter
{
	@liveness_all_by_comm[comm] = count();
}

END
{
	printf("TRACE-END nsecs=%lld\n", nsecs);
	print(@n_open);
	print(@n_write);
	print(@n_unlink);
	print(@n_exec);
	print(@n_connect);
	print(@n_sched_exec);
	print(@wr_family);
	print(@liveness_all_by_comm);
	print(@exec_by_comm);
	print(@fork_by_comm);
	clear(@n_open);
	clear(@n_write);
	clear(@n_unlink);
	clear(@n_exec);
	clear(@n_connect);
	clear(@n_sched_exec);
	clear(@wr_family);
	clear(@liveness_all_by_comm);
	clear(@exec_by_comm);
	clear(@fork_by_comm);
}
